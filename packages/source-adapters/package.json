{
  "name": "@tradelens/source-adapters",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sample": "./src/sample.ts",
    "./mm2values": "./src/mm2values.ts",
    "./supreme-import": "./src/supreme-import.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:mm2values": "node scripts/generate-mm2values.mjs",
    "sync:values": "node scripts/sync-values.mjs",
    "fetch:icons": "node scripts/fetch-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tradelens/item-schema": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
