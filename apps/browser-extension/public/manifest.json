{
  "manifest_version": 3,
  "name": "MM2 TradeLens",
  "version": "0.1.0",
  "description": "Independent fan-made MM2 value lookup from your browser toolbar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MM2 TradeLens"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
