{
  "name": "@tradelens/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node ../../scripts/prepare-desktop-data.mjs",
    "verify:fresh": "node ../../scripts/verify-snapshot-fresh.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite",
    "prebuild": "npm run verify:fresh && npm run prepare:data",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node ../../scripts/validate-desktop-bundle.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:preview": "npm run build && playwright test --config playwright.preview.config.ts",
    "test:e2e:update": "playwright test --update-snapshots=changed",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tradelens/item-schema": "0.1.0",
    "@tradelens/snapshot-signing": "0.1.0",
    "@tradelens/source-adapters": "0.1.0",
    "@tradelens/trade-engine": "0.1.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
