# Remote values feed (free static hosting on GitHub Pages). Baked in at build
# time so installed apps top up values automatically — no rebuild needed for
# future value updates. Unsigned: no VITE_SNAPSHOT_PUBLIC_KEY is set, so the
# app accepts the snapshot over HTTPS without signature verification.
VITE_SNAPSHOT_URL=https://shadowpanther123.github.io/mm2-tradelens/v1/snapshot
